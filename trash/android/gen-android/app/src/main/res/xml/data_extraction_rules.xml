<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Same files as backup_rules.xml: the journal
     database and the drawer-note switch, never the API keys. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="ember.db" />
        <include domain="root" path="ember.db-wal" />
        <include domain="root" path="ember.db-shm" />
        <include domain="sharedpref" path="ember-quick-note.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="ember.db" />
        <include domain="root" path="ember.db-wal" />
        <include domain="root" path="ember.db-shm" />
        <include domain="sharedpref" path="ember-quick-note.xml" />
    </device-transfer>
</data-extraction-rules>
